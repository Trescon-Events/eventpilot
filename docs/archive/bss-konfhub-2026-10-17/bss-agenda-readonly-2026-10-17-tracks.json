   {
    "session_id": "17192",
    "session_title": "Strengthening Bengaluru’s Blue-Collar Economy: Skills, Jobs and Pathways to Sustainable Livelihoods",
    "session_description": "<p><span data-olk-copy-source=\"MessageBody\" style=\"font-family: verdana,sans-serif;\">Bengaluru’s and Karnataka's growth relies heavily on its diverse blue-collar workforce across manufacturing, construction, logistics, mobility, retail, hospitality and essential services. As technology and industry needs evolve, building a future-ready workforce is critical. This Roundtable will bring together employers, government stakeholders, CSR leaders, academicians and skilling experts to explore industry-led skilling, employability, certification, inclusion, career progression and worker mobility. The discussion aims to strengthen collaboration across the ecosystem and shift the focus from training for jobs to building sustainable careers and livelihoods with insights finalised into a actionable roadmap for all the stakeholders</span></p>",
    "session_type": 1,
    "start_timestamp": "2026-11-05 05:30:00",
    "end_timestamp": "2026-11-05 07:30:00",
    "session_location": "",
    "session_colour": "#FFECD3",
    "session_order": 5,
    "track_assigned": true,
    "tags": [
