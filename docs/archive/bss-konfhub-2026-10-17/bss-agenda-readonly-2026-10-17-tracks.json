   {
    "session_id": "15769",
    "session_title": "The Rise of Hands-On Careers: New Opportunities in Skilled Employment",
    "session_description": "<p style=\"font-family: Hind, sans-serif;\">Hands-on careers are evolving, combining physical work with technical skills and increasingly sophisticated tools and technologies. This is creating new opportunities across industries such as aerospace, advanced manufacturing, infrastructure, energy and logistics. The discussion will explore how these roles are changing, what skills they require and how we can help young people see them as attractive careers for the future.</p>",
    "session_type": 1,
    "start_timestamp": "2026-11-05 05:10:00",
    "end_timestamp": "2026-11-05 05:50:00",
    "session_location": "India",
