   },
   {
    "session_id": "15770",
    "session_title": "The Care Economy: Preparing Talent for Global Opportunities",
    "session_description": "<p style=\"font-family: Hind, sans-serif;\">The growing demand for healthcare, eldercare, childcare and other care services is creating a significant international demand for a trained workforce. What does it take to prepare talent for these jobs and make their skills portable across borders? This conversation will provide insights on occupational standards, international certifications, language proficiency, soft skills and mobility readiness, including the role of structured training and overseas placement pathways.</p>",
    "session_type": 1,
    "start_timestamp": "2026-11-05 05:50:00",
    "end_timestamp": "2026-11-05 06:20:00",
    "session_location": "India",
