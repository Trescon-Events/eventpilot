   {
    "session_id": "16496",
    "session_title": "Reimagining Skilling for Workforce 2030: From Fragmented Efforts to an Integrated Skills Architecture",
    "session_description": "<p style=\"font-family: Hind, sans-serif;\"><span data-olk-copy-source=\"MessageBody\">Drawing on NITI Aayog’s Reimagining Skilling for Viksit Bharat@2047 report, the keynote will explore how India, and Karnataka in particular, can move towards a more integrated, outcome-oriented skilling ecosystem. It will focus on the convergence of skilling initiatives, stronger linkages between education, industry and employment, and the role of apprenticeships, lifelong learning, and institutional collaboration in building a future-ready workforce.</span></p>",
    "session_type": 1,
    "start_timestamp": "2026-11-05 09:00:00",
    "end_timestamp": "2026-11-05 09:30:00",
    "session_location": "India",
    "session_colour": "#FFECD3",
    "session_order": 13,
    "track_assigned": true,
    "tags": [
