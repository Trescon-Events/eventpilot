# Copy to .dev.vars (for `wrangler dev`) and/or .env (for drizzle-kit), then fill in.
# NEVER commit the filled-in file.

# Neon Postgres — get from https://console.neon.tech (use the pooled/HTTP connection string)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Random secret used to sign session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"

# Shared HMAC secret for the EventPilot SSO bridge — must exactly match the
# SMARTEXCEL_SSO_SECRET Railway env var on EventPilot. Generate with: openssl rand -hex 32
SMARTEXCEL_SSO_SECRET="change-me-to-a-long-random-string"

# Resend — get from https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="SmartExcel <onboarding@resend.dev>"

# Public app URL (used in email links)
APP_URL="http://localhost:3000"

# Permanent, non-revokable Super Admin (do not change without care — see roles.ts)
SUPER_ADMIN_EMAIL="md@tresconglobal.com"

# Google AI Studio / Gemini (Phase 1)
GEMINI_API_KEY=""

# Python processing worker base URL (Cloud Run / CF Containers; local: http://localhost:8000)
WORKER_URL="http://localhost:8000"
# Shared bearer token the Python worker uses to call back into the app (Phase 1)
WORKER_SHARED_SECRET=""

# R2 S3-compatible credentials for presigned upload/download URLs (Phase 1).
# Create an R2 API token in the Cloudflare dashboard (Account > R2 > Manage API tokens).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="smartexcel-files"
