# Shared bearer token the web app uses to authenticate to this worker.
WORKER_SHARED_SECRET=""

# R2 access (S3-compatible) — fill when implementing real processing.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="smartexcel-files"
R2_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"

# Callback into the web app to update job/run status.
APP_CALLBACK_URL="http://localhost:3000"
