# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Cloudflare build output
.open-next/
.wrangler/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local utility scripts (one-time ops, not part of the app)
/scripts/*
!/scripts/set-cf-secrets.sh

# supabase temp dir (local CLI state)
supabase/.temp/

# handoff drafts
HANDOFF_TO_*.md
